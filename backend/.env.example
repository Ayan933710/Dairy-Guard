# ==============================
# NANDI AI — Backend Config
# ==============================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL Database ---
# Full connection string (preferred). Example for local Postgres install:
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/nandi_db
# Set to "true" if connecting to a managed Postgres instance that requires SSL (e.g. RDS, Render, Supabase)
DATABASE_SSL=false

# --- Authentication ---
# IMPORTANT: Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- IoT Ingestion (ESP32-S3 devices) ---
# Shared secret ESP32 devices must send in the "x-device-key" header when POSTing telemetry directly over HTTP
DEVICE_INGEST_KEY=CHANGE_ME_TO_A_RANDOM_DEVICE_SECRET

# --- MQTT Broker Bridge (optional, for LoRa Hub / MQTT-based ESP32 firmware) ---
# If you don't have a broker yet, leave MQTT_ENABLED=false and use the HTTP ingestion route instead.
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=nandi/+/telemetry

# --- Python AI Microservice (XGBoost inference) ---
# URL of the Python service that serves the trained mastitis/heat-stress risk model.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
# If unreachable, the Node service falls back to a transparent rule-based risk score (see services/riskEngine.js)
AI_SERVICE_ENABLED=false
AI_MODEL_VERSION=nandi_ai_v2.2_calibrated

# --- Mastitis / High-Risk Alerts (WhatsApp, SMS, Email) ---
# Base URL used to build the "view this animal" link inside alert messages.
FRONTEND_URL=http://localhost:5173
# Risk score (0-100) at or above which an alert is sent. 75 = "High Risk".
ALERT_RISK_THRESHOLD=75

# Each channel below is OFF by default - turn one on only once you have real credentials.
# WhatsApp and SMS both go through Twilio (https://www.twilio.com/console): create a Twilio
# account, get a phone number enabled for SMS and/or the WhatsApp sandbox, then fill these in.
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_SMS_ENABLED=false
NOTIFY_CALL_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# Email alerts go through any SMTP account (Gmail app password, SendGrid, Mailgun, etc).
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@nandi.ai

# --- Administrator ---
# Password used by the seed script to create the main admin account
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
